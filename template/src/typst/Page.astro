---
import path from 'node:path';
import WacssDocs from '../layouts/WacssDocs.astro';
import { decorateTypstHtml, findTypstPage, renderTypst, typstBody, typstTitle } from './typst.ts';

const docsTemplate = (process.env.SSG_TEMPLATE ?? '').trim().toLowerCase() === 'wacss-docs';
const pagesDir = path.join(process.cwd(), 'src', 'pages');
let file = findTypstPage(pagesDir, Astro.url.pathname);
if (!file) {
	// Astro renders the injected /404 route for missing URLs, but Astro.url
	// still holds the original pathname. Fall back to the 404 Typst source.
	file = findTypstPage(pagesDir, '/404');
}
if (!file) {
	throw new Error(`No Typst page found for ${Astro.url.pathname}.`);
}

const html = decorateTypstHtml(renderTypst(file, pagesDir));
---

{
	docsTemplate ? (
		<WacssDocs title={typstTitle(html)} home={false}>
			<Fragment set:html={typstBody(html)} />
		</WacssDocs>
	) : (
		<Fragment set:html={html} />
	)
}
