---
// The drawer trigger, kept at the start of the nav bar so navigation reads
// left-to-right: menu, site title, then section links.
---

<button
  id="docs-menu"
  class="docs-menu-button"
  type="button"
  aria-controls="docs-sidebar"
  aria-expanded="false"
  aria-label="Open navigation"
>☰</button>
