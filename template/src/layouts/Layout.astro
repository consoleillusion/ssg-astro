---
interface Props {
	title?: string;
}

const { title = 'Astro Basics' } = Astro.props;

// Classless stylesheet theme, set by `astro-ssg serve --classless <theme>`.
const classless = process.env.SSG_CLASSLESS ?? '';
// User stylesheet, set by `astro-ssg serve --css <file>`. Loaded after the
// classless stylesheet so it wins on equal specificity.
const userCss = process.env.SSG_CSS_PATH ? '/astro-ssg-user.css' : '';
---

<!doctype html>
<html lang="en" class={classless ? undefined : 'ssg-reset'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{classless && (
			<link
				rel="stylesheet"
				href={`/${classless}.css`}
				data-ssg-classless={classless}
			/>
		)}
		{userCss && (
			<link
				rel="stylesheet"
				href={userCss}
				data-ssg-css
			/>
		)}
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	.ssg-reset,
	.ssg-reset body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
