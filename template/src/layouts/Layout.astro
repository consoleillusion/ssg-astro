---
import Menu from '../menu/Menu.astro';

interface Props {
	title?: string;
}

const { title = 'Astro Basics' } = Astro.props;

// Theme stylesheet, set by `astro-ssg serve --theme <theme>`.
const theme = process.env.SSG_THEME ?? '';
// User stylesheet, set by `astro-ssg serve --css <file>`. Loaded after the
// theme stylesheet so it wins on equal specificity.
const userCss = process.env.SSG_CSS_PATH ? '/astro-ssg-user.css' : '';
// Page navigation menu, set by `astro-ssg serve --menu`.
const menu = process.env.SSG_MENU === '1';
---

<!doctype html>
<html lang="en" class={theme ? undefined : 'ssg-reset'}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{theme && (
			<link
				rel="stylesheet"
				href={`/${theme}.css`}
				data-ssg-theme={theme}
			/>
		)}
		{userCss && (
			<link
				rel="stylesheet"
				href={userCss}
				data-ssg-css
			/>
		)}
	</head>
	<body>
		<slot />
		{menu && <Menu />}
	</body>
</html>

<style>
	.ssg-reset,
	.ssg-reset body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
