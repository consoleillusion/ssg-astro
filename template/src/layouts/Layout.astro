interface Props {
	title?: string;
}

const { title = 'Astro Basics' } = Astro.props;

// Classless stylesheet: injected when SSG_CLASSLESS env var is set via --classless flag
const classless = process.env.SSG_CLASSLESS === '1';

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Classless stylesheet -->
		<link rel="stylesheet" href="/sakura.css" data-ssg-classless={classless} />
	</head>
	<body>
		<slot />
	</body>
</html>
<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>