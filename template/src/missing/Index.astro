---
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import { listPages } from '../routes.js';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isRoot = pathname === '/';

const pagesDir = path.join(process.cwd(), 'src', 'pages');
const pages = isRoot
	? listPages(pagesDir).sort((a, b) => a.url.localeCompare(b.url))
	: [];
---
<Layout title={isRoot ? 'Default page' : 'Page not found'}>
	<main>
		{
			isRoot ? (
				<>
					<h1>Default page served</h1>
					<p>
						No index page was found in this directory, so this default page is served
						with HTTP status 200.
					</p>
					<p>Add one of these files to create the home page:</p>
					<ul class="files">
						<li><code>index.astro</code></li>
						<li><code>index.html</code></li>
						<li><code>index.md</code></li>
						<li><code>index.mdx</code></li>
					</ul>
				</>
			) : (
				<>
					<h1>Page not found</h1>
					<p>
						No page exists at <code>{pathname}</code>.
					</p>
				</>
			)
		}

		<p>This server only serves these page file types:</p>
		<ul class="files">
			<li><code>.astro</code></li>
			<li><code>.html</code></li>
			<li><code>.md</code></li>
			<li><code>.mdx</code></li>
		</ul>

		{
			isRoot && pages.length > 0 && (
				<section>
					<h2>Existing pages</h2>
					<ul class="pages">
						{pages.map((page) => (
							<li>
								<a href={page.url}>{page.url}</a>
								<span class="source">{page.file}</span>
							</li>
						))}
					</ul>
				</section>
			)
		}
	</main>
</Layout>

<style>
	main {
		box-sizing: border-box;
		max-width: 42rem;
		margin: 0 auto;
		padding: 3rem 1.5rem;
		font-family: system-ui, sans-serif;
		line-height: 1.6;
	}

	h1 {
		margin-top: 0;
	}

	.files {
		padding-left: 1.25rem;
	}

	.files li + li {
		margin-top: 0.25rem;
	}

	.pages {
		padding-left: 1.25rem;
	}

	.pages li + li {
		margin-top: 0.25rem;
	}

	.source {
		margin-left: 0.5rem;
		color: #666;
		font-size: 0.875em;
	}
</style>
